# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Build artifacts
dist/

# SLURM logs (keep the dir, ignore the output files)
logs/*.out
logs/*.err
!logs/.gitkeep

# Env
.env
# .venv* not .venv: audit envs (.venv-audit/, per the workspace convention)
# are created in-tree, and an unignored one gets swept into the sdist.
.venv*/
.pytest_cache/
sails-vlm.yaml
